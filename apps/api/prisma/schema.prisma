// Модель данных — ТЗ раздел 4. Именование таблиц: snake_case, множественное число.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  STAFF
  TEACHER
  ADMIN
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  NEEDS_FIX
  AWAITING_SIGNATURE
  APPROVED
  READY
  ISSUED
  REJECTED
  CANCELLED
}

enum StageStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  RETURNED
  SKIPPED
}

enum CellStatus {
  FREE
  OCCUPIED
  MAINTENANCE
}

enum BookingStatus {
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum FileKind {
  ATTACHMENT
  GENERATED_DOCUMENT
  SIGNED_SCAN
}

enum FieldType {
  TEXT
  TEXTAREA
  NUMBER
  DATE
  DATE_RANGE
  SELECT
  CHECKBOX
  FILE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  PUSH
}

enum DevicePlatform {
  IOS
  ANDROID
}

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email         String   @unique @db.VarChar(255)
  passwordHash  String   @map("password_hash") @db.VarChar(255)
  fullName      String   @map("full_name") @db.VarChar(255)
  role          UserRole
  groupName     String?  @map("group_name") @db.VarChar(64)
  course        Int?     @db.SmallInt
  department    String?  @db.VarChar(128)
  isBudget      Boolean  @default(false) @map("is_budget")
  studentCardNo String?  @unique @map("student_card_no") @db.VarChar(32)
  phone         String?  @db.VarChar(32)
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  applications     Application[]
  approvedStages   ApplicationStage[] @relation("StageApprover")
  files            File[]
  bookings         Booking[]
  events           EventLog[]
  notifications    Notification[]
  refreshTokens    RefreshToken[]
  deviceTokens     DeviceToken[]

  @@index([role])
  @@index([department])
  @@index([groupName])
  @@map("users")
}

model ApplicationType {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code              String   @unique @db.VarChar(64)
  name              String   @db.VarChar(255)
  description       String?
  icon              String?  @db.VarChar(64)
  fieldsSchema      Json     @map("fields_schema")
  accessRule        Json?    @map("access_rule")
  requiresSignature Boolean  @default(false) @map("requires_signature")
  usesCell          Boolean  @default(false) @map("uses_cell")
  usesBooking       Boolean  @default(false) @map("uses_booking")
  documentTemplate  String?  @map("document_template") @db.VarChar(128)
  sortOrder         Int      @default(0) @map("sort_order")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  routeSteps   RouteStep[]
  applications Application[]

  @@map("application_types")
}

model RouteStep {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  typeId             String  @map("type_id") @db.Uuid
  orderNum           Int     @map("order_num")
  name               String  @db.VarChar(255)
  approverDepartment String  @map("approver_department") @db.VarChar(128)
  isAuto             Boolean @default(false) @map("is_auto")
  isOptional         Boolean @default(false) @map("is_optional")
  slaDays            Int?    @map("sla_days")

  type   ApplicationType    @relation(fields: [typeId], references: [id], onDelete: Cascade)
  stages ApplicationStage[]

  @@unique([typeId, orderNum])
  @@map("route_steps")
}

model Application {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  number         String            @unique @db.VarChar(32)
  userId         String            @map("user_id") @db.Uuid
  typeId         String            @map("type_id") @db.Uuid
  status         ApplicationStatus @default(DRAFT)
  data           Json              @default("{}")
  currentStageId String?           @map("current_stage_id") @db.Uuid
  rejectReason   String?           @map("reject_reason")
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  submittedAt    DateTime?         @map("submitted_at") @db.Timestamptz(6)
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)

  user          User               @relation(fields: [userId], references: [id])
  type          ApplicationType    @relation(fields: [typeId], references: [id])
  stages        ApplicationStage[] @relation("ApplicationStages")
  currentStage  ApplicationStage?  @relation("CurrentStage", fields: [currentStageId], references: [id])
  files         File[]
  cell          Cell?
  booking       Booking?
  events        EventLog[]
  notifications Notification[]

  @@index([userId, status])
  @@index([typeId, status])
  @@index([status, submittedAt])
  @@map("applications")
}

model ApplicationStage {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId      String      @map("application_id") @db.Uuid
  routeStepId        String?     @map("route_step_id") @db.Uuid
  orderNum           Int         @map("order_num")
  name               String      @db.VarChar(255)
  approverDepartment String      @map("approver_department") @db.VarChar(128)
  status             StageStatus @default(PENDING)
  approvedById       String?     @map("approved_by") @db.Uuid
  comment            String?
  dueAt              DateTime?   @map("due_at") @db.Timestamptz(6)
  actedAt            DateTime?   @map("acted_at") @db.Timestamptz(6)

  application    Application  @relation("ApplicationStages", fields: [applicationId], references: [id], onDelete: Cascade)
  routeStep      RouteStep?   @relation(fields: [routeStepId], references: [id])
  approvedBy     User?        @relation("StageApprover", fields: [approvedById], references: [id])
  currentOfApps  Application[] @relation("CurrentStage")

  @@index([applicationId, orderNum])
  @@index([approverDepartment, status])
  @@map("application_stages")
}

model File {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId  String   @map("application_id") @db.Uuid
  uploadedById   String   @map("uploaded_by") @db.Uuid
  kind           FileKind
  fieldKey       String?  @map("field_key") @db.VarChar(64)
  originalName   String   @map("original_name") @db.VarChar(255)
  storageKey     String   @map("storage_key") @db.VarChar(512)
  mimeType       String   @map("mime_type") @db.VarChar(128)
  sizeBytes      BigInt   @map("size_bytes")
  checksumSha256 String?  @map("checksum_sha256") @db.VarChar(64)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id])

  @@map("files")
}

model Cell {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code          String     @unique @db.VarChar(16)
  location      String?    @db.VarChar(255)
  status        CellStatus @default(FREE)
  applicationId String?    @unique @map("application_id") @db.Uuid
  pickupCode    String?    @map("pickup_code") @db.VarChar(8)
  occupiedAt    DateTime?  @map("occupied_at") @db.Timestamptz(6)
  expiresAt     DateTime?  @map("expires_at") @db.Timestamptz(6)

  application Application? @relation(fields: [applicationId], references: [id])

  @@index([status])
  @@map("cells")
}

model BookingPeriod {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   @db.VarChar(255)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  quota     Int
  isOpen    Boolean  @default(true) @map("is_open")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  bookings Booking[]

  @@map("booking_periods")
}

model Booking {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationId String        @unique @map("application_id") @db.Uuid
  periodId      String        @map("period_id") @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  status        BookingStatus
  queuePosition Int?          @map("queue_position")
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  cancelledAt   DateTime?     @map("cancelled_at") @db.Timestamptz(6)

  application Application   @relation(fields: [applicationId], references: [id])
  period     BookingPeriod @relation(fields: [periodId], references: [id])
  user       User          @relation(fields: [userId], references: [id])

  @@index([periodId, status])
  @@index([userId, status])
  @@map("bookings")
}

model EventLog {
  id            BigInt   @id @default(autoincrement())
  applicationId String?  @map("application_id") @db.Uuid
  actorId       String?  @map("actor_id") @db.Uuid
  action        String   @db.VarChar(64)
  payload       Json     @default("{}")
  ipAddress     String?  @map("ip_address") @db.Inet
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  application Application? @relation(fields: [applicationId], references: [id])
  actor      User?        @relation(fields: [actorId], references: [id])

  @@index([applicationId])
  @@index([actorId])
  @@index([action])
  @@map("event_log")
}

model Notification {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String              @map("user_id") @db.Uuid
  applicationId String?             @map("application_id") @db.Uuid
  title         String              @db.VarChar(255)
  body          String
  link          String?             @db.VarChar(512)
  channel       NotificationChannel @default(IN_APP)
  isRead        Boolean             @default(false) @map("is_read")
  sentAt        DateTime?           @map("sent_at") @db.Timestamptz(6)
  createdAt     DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user        User         @relation(fields: [userId], references: [id])
  application Application?  @relation(fields: [applicationId], references: [id])

  @@index([userId, isRead, createdAt(sort: Desc)])
  @@map("notifications")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// TZ-GAP: пуш-канал (отклонение п.6 плана) — токены устройств для APNs/FCM.
model DeviceToken {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  platform  DevicePlatform
  token     String         @unique @db.VarChar(512)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt DateTime      @default(now()) @map("last_seen_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
