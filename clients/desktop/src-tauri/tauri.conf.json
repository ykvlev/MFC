{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Единое окно",
  "version": "0.1.0",
  "identifier": "local.university.edinoe-okno.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "Единое окно студента",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src 'self' http://localhost:3000 https://okno.university.local"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico", "icons/icon.icns"],
    "copyright": "Единое окно студента",
    "category": "Education",
    "shortDescription": "Рабочее место сотрудника",
    "longDescription": "Согласование заявок, выдача документов через ячейки, приёмные окна и объявления."
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://okno.university.local/updates/latest.json"],
      "dialog": true,
      "pubkey": "REPLACE_WITH_TAURI_SIGNING_PUBLIC_KEY"
    }
  }
}
